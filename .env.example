# Copy to .env (never commit it). Health works with none of these set.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# Neon PostgreSQL. App = pooled URL, migrations = direct URL. Paste Neon's string as-is
# (sslmode / channel_binding are translated for asyncpg automatically).
DATABASE_URL=
DATABASE_URL_DIRECT=

# Static bearer token for the API. Use 24+ random characters when APP_ENV=production.
API_AUTH_TOKEN=

# Meta Model API: verify endpoint, auth and model IDs against the event docs (slice 5).
META_MODEL_API_KEY=
META_MODEL_BASE_URL=
META_PLANNER_MODEL=
META_FAST_MODEL=

# Sandbox: "fake" needs nothing. "modal" is implemented in slice 9.
SANDBOX_PROVIDER=fake
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_SANDBOX_IMAGE=
SANDBOX_TIMEOUT_SECONDS=60

MAX_CONCURRENCY=3
MAX_WORKFLOW_TASKS=20
MAX_TASK_ATTEMPTS=2
MAX_MODEL_CALLS_PER_RUN=50
